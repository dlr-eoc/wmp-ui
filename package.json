    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@angular/language-service": "^21.2.13",
    "@types/node": "^25.9.1",
    "@types/uuid": "^9.0.8",
    "@vitest/ui": "4.1.10",
    "graphviz": "^0.0.9",
    "jsdom": "^30.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
