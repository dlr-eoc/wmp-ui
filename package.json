{
  "name": "wmp-ui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "ng build --source-map",
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "test-ui": "ng test --ui",
    "watch": "ng build --watch --configuration development",
    "dep:madge": "madge --circular --extensions ts src/main.ts",
    "dep:madge:graph": "madge --circular --extensions ts --image dep-graph.png src/main.ts --ts-config tsconfig.json"
  },
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/material": "^21.2.11",
    "@angular/platform-browser": "^21.2.13",
    "@angular/router": "^21.2.15",
    "@cds/angular": "^6.17.0",
    "@cds/core": "^6.17.0",
    "@clr/angular": "^18.0.0",
    "@clr/icons": "^13.0.2",
    "@clr/ui": "^18.0.0",
    "@primeng/themes": "^21.0.4",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "bpmn-js": "^17.11.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.2.1",
    "date-fns-tz": "^3.2.0",
    "diagram-js": "^14.11.3",
    "ngx-mask": "^14.3.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.7",
    "rxjs": "^7.8.2",
    "tiny-svg": "^4.1.4",
    "tslib": "^2.8.1",
    "uuid": "^14.0.0",
    "zone.js": "^0.15.1"
  },
